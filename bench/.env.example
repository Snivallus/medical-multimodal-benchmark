# Copy to .env and fill in your own key. The file is git-ignored.

# AI STORE (中国电信) endpoint. Both forms work:
#   https://ai.api.coregpu.cn/v1
#   https://ai.api.coregpu.cn/v1/chat/completions
LLM_BASE_URL=https://ai.api.coregpu.cn/v1

# Your API key from the AI STORE console.
LLM_API_KEY=

# Any model id listed by `python bench/check_api.py`; Qwen3.8-Max is multimodal and
# was used for the rewrite/distractor steps, Qwen-Flash-A for the fast audit.
LLM_MODEL=Qwen3.8-Max
