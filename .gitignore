# Model cache / large files
cache/
offload_tmp/
.tmp/

# Log files of `case_filter.py` and `case_rewrite.py`
logs/

# Virtual environments
venv/
.env
.env/
.venv/
bench/.env

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pylibs/

# Evaluation runs: keep the final per-item outputs and summary; smoke tests,
# server logs, and stale manifests stay local. bench/data itself is tracked.
bench/results/**
!bench/results/
!bench/results/*/
!bench/results/*/items.jsonl
!bench/results/*/conflicts.jsonl
!bench/results/summary.md
!bench/results/README.md

# The upstream crawl project: 11 MB of crawl output plus 800 MB of images, and
# none of it is needed to reproduce the benchmark. bench/data is self-contained
# (items, conflicts, the case export and the images it references), so a clone
# can evaluate without it; only re-crawling or re-deriving the items needs it.
iiyi_dataset/
